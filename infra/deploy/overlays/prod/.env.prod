# =============================================================================
# Configuration de l'environnement prod
# =============================================================================
# Les secrets sont fournis via .env.secrets (ignoré par git), fusionné par la CI.
# Les valeurs de base sont chargées depuis base/.env.base d'abord.
# =============================================================================

# Nom d'hôte (un seul domaine, l'application est servie à la racine)
HOST_NAME=your-domain.com

# Versions (remplacée par la CI avec la version demandée au déploiement)
APP_VERSION=0.1.0


# E-mails via l'API Brevo (optionnel) : clé en secret, expéditeur validé chez Brevo
APP_BREVO_API_KEY=
APP_MAIL_FROM=
# Liste Brevo des invitations (identifiant numérique, facultatif)
APP_BREVO_LIST_ID=
