# =============================================================================
# Configuration de l'environnement local
# =============================================================================
# En local, rien ne tourne dans Docker : PocketBase est lancé comme binaire par
# scripts/pb.sh (make dev). Ce fichier n'existe que pour que deploy.sh local
# valide la configuration et pour disposer d'un jeu de valeurs cohérent.
# Les valeurs de base sont chargées depuis base/.env.base d'abord.
# =============================================================================

# Versions
APP_VERSION=local

# Hôte (sans effet en local, Traefik désactivé)
HOST_NAME=localhost


# E-mails via Brevo (optionnel)
APP_BREVO_API_KEY=
APP_MAIL_FROM=
# Liste Brevo des invitations (identifiant numérique, facultatif)
APP_BREVO_LIST_ID=
